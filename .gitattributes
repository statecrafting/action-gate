# Enforce LF line endings for all text files in this repository.
* text=auto eol=lf

# --- Source code ---
*.rs        text eol=lf

# --- Config / markup ---
*.json      text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# --- Docs ---
*.md        text eol=lf
*.txt       text eol=lf

# --- Shell / config ---
*.sh        text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# --- Binary: never touch line endings ---
*.png       binary
*.jpg       binary
*.gif       binary
*.pdf       binary
*.gz        binary

# --- Derived-artifact merge driver (forward-looking) ---
# The committed .statecraft/derived/ shards are regenerated, never merged by
# hand: two branches that both regenerated the per-spec / per-package JSON
# shards would conflict textually. The `action-gate-derived-regen` driver
# regenerates them from the merged tree instead of leaving conflict markers.
# Opt-in per-clone (no clone defines it yet). build-meta.json is gitignored,
# so the glob never touches it.
.statecraft/derived/**/*.json merge=action-gate-derived-regen
